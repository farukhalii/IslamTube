<!-- Continuous Feed Layout inside ScrollView -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 1. Long Video -->
    <include layout="@layout/item_long_video" />

    <!-- 2. Long Video -->
    <include layout="@layout/item_long_video" />

    <!-- 3. Shorts Carousel -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <include layout="@layout/item_shorts_card" />
            <include layout="@layout/item_shorts_card" />
            <include layout="@layout/item_shorts_card" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 4. Long Video -->
    <include layout="@layout/item_long_video" />

    <!-- 5. Community Post Card -->
    <include layout="@layout/item_post_card" />

    <!-- 6. Long Video -->
    <include layout="@layout/item_long_video" />

    <!-- 7. Sponsored Ad Card -->
    <include layout="@layout/item_ad_card" />

    <!-- 8. Long Video -->
    <include layout="@layout/item_long_video" />

</LinearLayout>
